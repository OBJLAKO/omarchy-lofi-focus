{
  "schemaVersion": 1,
  "id": "sky.lofi",
  "name": "Skylofi",
  "version": "3.5.0",
  "author": "OBJLAKO",
  "license": "MIT",
  "description": "A quiet sound space: radio, saved YouTube audio, reusable scenes and spatial ambience with a native Rust mixer.",
  "keywords": [
    "lofi",
    "youtube",
    "lofi-girl",
    "radio",
    "podcasts",
    "ambient",
    "focus",
    "voxtype",
    "soundscape",
    "scenes",
    "spatial"
  ],
  "kinds": [
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Skylofi",
    "description": "Radio, voice, saved scenes and spatial ambience.",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
