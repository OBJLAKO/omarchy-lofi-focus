#!/usr/bin/env python3
"""Read exactly one mpv response instead of waiting for socat's EOF timeout."""
import json
import socket
import sys
try:
    command = json.loads(sys.argv[2])
    command['request_id'] = 1
    with socket.socket(socket.AF_UNIX) as client:
        client.settimeout(0.5)
        client.connect(sys.argv[1])
        client.sendall((json.dumps(command) + '\n').encode())
        with client.makefile('r') as stream:
            for line in stream:
                if json.loads(line).get('request_id') == 1:
                    print(line.strip())
                    break
except (OSError, ValueError):
    sys.exit(1)
